[Unit]
Description=ubtms Push Bridge Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/ubtms-push-bridge
ExecStart=/opt/ubtms-push-bridge/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=BRIDGE_PUBLIC_URL=https://push.example.com
Environment=UBPORTS_PUSH_URL=https://push.ubports.com/notify
Environment=UBPORTS_APP_ID=ubtms_ubtms
Environment=BRIDGE_DB_PATH=/opt/ubtms-push-bridge/subscriptions.db

[Install]
WantedBy=multi-user.target
